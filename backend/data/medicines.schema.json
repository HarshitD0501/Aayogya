{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aushadhai.example/schemas/medicines.schema.json",
  "title": "AushadhAi medicine catalogue",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "checked_on", "records"],
  "properties": {
    "version": { "type": "string", "minLength": 1 },
    "checked_on": { "$ref": "#/$defs/date" },
    "records": { "type": "array", "items": { "$ref": "#/$defs/medicine" } }
  },
  "$defs": {
    "date": { "type": "string", "format": "date" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_url", "document_ref", "row_ref", "checked_on", "source_as_of"],
      "properties": {
        "source_url": { "type": "string", "format": "uri", "pattern": "^https://" },
        "document_ref": { "type": "string", "minLength": 1 },
        "row_ref": { "type": "string", "minLength": 1 },
        "checked_on": { "$ref": "#/$defs/date" },
        "source_as_of": { "$ref": "#/$defs/date" }
      }
    },
    "component": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "amount", "unit"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "amount": { "type": "number", "exclusiveMinimum": 0 },
        "unit": { "enum": ["mg", "mcg", "g", "IU", "%"] }
      }
    },
    "pack": {
      "type": "object", "additionalProperties": false,
      "required": ["quantity", "unit"],
      "properties": {
        "quantity": { "type": "integer", "minimum": 1 },
        "unit": { "enum": ["tablet", "capsule", "vial", "sachet", "ml", "g"] }
      }
    },
    "price": {
      "type": "object", "additionalProperties": false,
      "required": ["amount_paise", "currency", "unit", "source"],
      "properties": {
        "amount_paise": { "type": "integer", "minimum": 0 },
        "currency": { "const": "INR" },
        "unit": { "enum": ["pack", "tablet", "capsule", "ml", "g", "vial", "sachet"] },
        "source": { "$ref": "#/$defs/source" }
      }
    },
    "brand": {
      "type": "object", "additionalProperties": false,
      "required": ["brand_id", "name", "molecule_components", "form", "release_type", "pack", "market_price", "source"],
      "properties": {
        "brand_id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1 },
        "molecule_components": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/component" } },
        "form": { "enum": ["tablet", "capsule", "injection", "syrup", "solution", "gel", "cream", "sachet"] },
        "release_type": { "type": ["string", "null"], "enum": ["immediate", "extended", "delayed", null] },
        "pack": { "$ref": "#/$defs/pack" },
        "market_price": { "oneOf": [{ "$ref": "#/$defs/price" }, { "type": "null" }] },
        "source": { "$ref": "#/$defs/source" }
      }
    },
    "medicine": {
      "type": "object", "additionalProperties": false,
      "required": ["medicine_id", "product_code", "molecule_components", "molecule_label", "strength_label", "form", "release_type", "pack", "pmbjp_price", "nppa_ceiling_price", "brand_products", "source", "reviewed_by", "reviewed_on", "record_status"],
      "properties": {
        "medicine_id": { "$ref": "#/$defs/id" },
        "product_code": { "type": ["string", "null"], "minLength": 1 },
        "molecule_components": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/component" } },
        "molecule_label": { "type": "string", "minLength": 1 },
        "strength_label": { "type": "string", "minLength": 1 },
        "form": { "enum": ["tablet", "capsule", "injection", "syrup", "solution", "gel", "cream", "sachet"] },
        "release_type": { "type": ["string", "null"], "enum": ["immediate", "extended", "delayed", null] },
        "pack": { "$ref": "#/$defs/pack" },
        "pmbjp_price": { "oneOf": [{ "$ref": "#/$defs/price" }, { "type": "null" }] },
        "nppa_ceiling_price": { "oneOf": [{ "$ref": "#/$defs/price" }, { "type": "null" }] },
        "brand_products": { "type": "array", "items": { "$ref": "#/$defs/brand" } },
        "source": { "$ref": "#/$defs/source" },
        "reviewed_by": { "type": ["string", "null"] },
        "reviewed_on": { "oneOf": [{ "$ref": "#/$defs/date" }, { "type": "null" }] },
        "record_status": { "enum": ["verified", "incomplete", "retired"] },
        "usage_summary": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["hi", "en", "source"],
              "properties": {
                "hi": { "type": "string", "minLength": 1 },
                "en": { "type": "string", "minLength": 1 },
                "source": { "$ref": "#/$defs/source" }
              }
            },
            { "type": "null" }
          ]
        }
      }
    }
  }
}
