# Copy to .env and fill in. Configure a vision provider for prescription extraction.
# Local demo accounts are opt-in. Never enable them in production.
ENVIRONMENT=development
ENABLE_DEMO_ACCOUNTS=false
# Development-only canned prescription fallback. Production rejects this setting.
ENABLE_MOCK_EXTRACTION=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
DATABASE_URL=sqlite:///./aayogya.db
# Scale: run `docker compose up -d` then use Postgres (LangGraph checkpoints +
# app data both live here). Pool is tunable via DB_POOL_SIZE / DB_MAX_OVERFLOW.
# DATABASE_URL=postgresql+psycopg://aarogya:aarogya@localhost:5432/aarogya
# Generate a stable production key with: openssl rand -hex 32
# Production startup requires this key (64 hex characters).
SECRET_KEY=
GOOGLE_CLIENT_ID=your-google-oauth-web-client-id.apps.googleusercontent.com

# Twilio Voice & Telephony (PSTN Outbound Calls)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_SIP_DOMAIN=aayogya.pstn.twilio.com
TWILIO_SIP_USERNAME=
TWILIO_SIP_PASSWORD=
TWILIO_ENABLE_AMD=true
TWILIO_STATUS_CALLBACK_URL=
LIVEKIT_SIP_TRUNK_ID=

# LiveKit Server Keys (needed to dispatch SIP participant calls)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
